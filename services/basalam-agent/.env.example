# Behdashtik AI agent service — sample configuration (no real secrets).
BDSK_AI_HOST=127.0.0.1
BDSK_AI_PORT=8010
BDSK_AI_PUBLIC_BASE_URL=https://support.behdashtik.ir/ai-agent
BDSK_AI_DB_PATH=data/agent.db
BDSK_AI_LOG_LEVEL=INFO

# generate: python3 -c "import secrets; print(secrets.token_hex(32))"
BDSK_AI_ADMIN_TOKEN=
# generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BDSK_AI_FERNET_KEY=

BDSK_AI_CHATWOOT_BASE_URL=http://127.0.0.1:4000
BDSK_AI_CHATWOOT_PUBLIC_URL=https://support.behdashtik.ir
BDSK_AI_CHATWOOT_ACCOUNT_ID=2
BDSK_AI_CHATWOOT_INBOX_ID=1
# from scripts/register_agent_bot.py output
BDSK_AI_CHATWOOT_BOT_TOKEN=
BDSK_AI_CHATWOOT_WEBHOOK_SECRET=
# access token of a dedicated Chatwoot operator account (message-history reads)
BDSK_AI_CHATWOOT_USER_TOKEN=

BDSK_AI_HUB_BASE_URL=https://hub.behdashtik.ir
# from wordpress-data-hub server2/config.json agent_api.key
BDSK_AI_HUB_AGENT_API_KEY=
# from the Hub dashboard webhook registration (shown once)
BDSK_AI_HUB_WEBHOOK_SECRET=

# Main site: conversations on this inbox are answered from the main hub instead
# of the dev hub above. Leave the inbox id at 0 to run against dev only.
BDSK_AI_MAIN_INBOX_ID=0
BDSK_AI_MAIN_HUB_BASE_URL=https://mainhub.behdashtik.ir
# from behdashtik-hub-main server2/config.json agent_api.key
BDSK_AI_MAIN_HUB_AGENT_API_KEY=

BDSK_AI_OPENROUTER_API_KEY=

BDSK_AI_TELEGRAM_BOT_TOKEN=
BDSK_AI_TELEGRAM_WEBHOOK_SECRET=

BDSK_AI_LANGSMITH_ENABLED=false
# when enabling LangSmith also export LANGCHAIN_API_KEY / LANGCHAIN_PROJECT
